{
  "name": "pantry-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run content",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "npm run content && tsc --noEmit",
    "test": "npm run content && vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "add-recipe-check": "tsx scripts/recipes.ts check",
    "content": "tsx scripts/recipes.ts build",
    "icons": "tsx scripts/make-icons.ts"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
